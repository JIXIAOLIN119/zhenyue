{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "@/ui/*": ["./packages/webui/*"],
      "@zhenyue/webui": ["./packages/webui/index.html"],
      "@zhenyue/api": ["./packages/api/src/index.ts"],
      "@zhenyue/core": ["./packages/core/src/index.ts"],
      "@zhenyue/core/src/*": ["./packages/core/src/*"],
      "@zhenyue/db": ["./packages/db/src/index.ts"],
      "@zhenyue/db/enums": ["./packages/db/src/generated/prisma/enums.ts"],
      "@zhenyue/db/test": ["./packages/db/src/test.ts"],
      "@zhenyue/dtos": ["./packages/dtos/src/index.ts"],
      "@zhenyue/workflow-core": ["./packages/workflow-core/src/index.ts"],
      "@zhenyue/workflow-core/src/*": ["./packages/workflow-core/src/*"],
      "@zhenyue/agent": ["./packages/agent/src/index.ts"],
      "@zhenyue/agent/src/*": ["./packages/agent/src/*"],
      "@zhenyue/transcode": ["./packages/transcode/src/index.ts"],
      "@zhenyue/transcode/src/*": ["./packages/transcode/src/*"],
      "@zhenyue/cli": ["./apps/cli/src/index.ts"],
      "@zhenyue/tableprinter": ["./packages/tableprinter/src/index.ts"],
      "@zhenyue/e2e/*": ["./packages/e2e/*"]
    }
  },
  "exclude": ["node_modules"]
}
